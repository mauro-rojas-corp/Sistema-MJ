{
  "manifest_version": 3,
  "name": "Ekuatia Login PRUEBAS",
  "version": "2.22",
  "key": "",
  "description": "[PRUEBAS] Puente de Control Clientes: login y Formulario 120 en Marangatu, descarga de formularios IVA y envío de la ficha por WhatsApp Web",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "contentSettings"
  ],
  "host_permissions": [
    "https://marangatu.set.gov.py/*",
    "https://ekuatia.set.gov.py/*",
    "https://web.whatsapp.com/*",
    "https://api.capsolver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ekuatia Login PRUEBAS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icono-16.png",
      "32": "icono-32.png",
      "48": "icono-48.png",
      "128": "icono-128.png"
    }
  },
  "icons": {
    "16": "icono-16.png",
    "32": "icono-32.png",
    "48": "icono-48.png",
    "128": "icono-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "asistente-logo.png"
      ],
      "matches": [
        "https://marangatu.set.gov.py/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://sistema-mj.vercel.app/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://marangatu.set.gov.py/*"
      ],
      "js": [
        "descargaContent.js",
        "paginas.js",
        "relevamientoNav.js",
        "panelContent.js",
        "recolectorCdcCore.js",
        "recolectorCdcPagina.js",
        "recolectorCdcLotes.js",
        "recolectorCdcUi.js",
        "asistenteMj.js"
      ],
      "css": [
        "asistenteMj.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ekuatia.set.gov.py/consultas*"
      ],
      "js": [
        "recolectorCdcCore.js",
        "ekuatiaPagina.js",
        "ekuatiaUi.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://marangatu.set.gov.py/*"
      ],
      "js": [
        "formulario120.js",
        "ivaContent.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
